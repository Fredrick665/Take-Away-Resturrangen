{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "The AWS CloudFormation template for this Serverless application",
  "Resources": {
    "RegisterUserLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/swift-deluxe-api-dev-registerUser"
      }
    },
    "LoginUserLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/swift-deluxe-api-dev-loginUser"
      }
    },
    "RegisterUserLambdaFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Code": {
          "S3Bucket": "serverless-framework-deployments-eu-north-1-193c9376-f19d",
          "S3Key": "serverless/swift-deluxe-api/dev/1732719643124-2024-11-27T15:00:43.124Z/swift-deluxe-api.zip"
        },
        "Handler": "functions/userfunctions/addnewuser.handler",
        "Runtime": "nodejs20.x",
        "FunctionName": "swift-deluxe-api-dev-registerUser",
        "MemorySize": 1024,
        "Timeout": 6,
        "Environment": {
          "Variables": {
            "JWT_SECRET": "someRandomSecretKey12345"
          }
        },
        "Role": "arn:aws:iam::796973483684:role/LambdaDynamoDbRole"
      },
      "DependsOn": [
        "RegisterUserLogGroup"
      ]
    },
    "LoginUserLambdaFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Code": {
          "S3Bucket": "serverless-framework-deployments-eu-north-1-193c9376-f19d",
          "S3Key": "serverless/swift-deluxe-api/dev/1732719643124-2024-11-27T15:00:43.124Z/swift-deluxe-api.zip"
        },
        "Handler": "functions/userfunctions/loginUser.handler",
        "Runtime": "nodejs20.x",
        "FunctionName": "swift-deluxe-api-dev-loginUser",
        "MemorySize": 1024,
        "Timeout": 6,
        "Environment": {
          "Variables": {
            "JWT_SECRET": "someRandomSecretKey12345"
          }
        },
        "Role": "arn:aws:iam::796973483684:role/LambdaDynamoDbRole"
      },
      "DependsOn": [
        "LoginUserLogGroup"
      ]
